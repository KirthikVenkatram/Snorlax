rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Single-user app: every document under users/{uid} — at any depth,
    // including all subcollections (workouts, foodLogs, recipes, habits,
    // dailyChecklist, disciplineScores, etc.) — is only readable/writable
    // by the authenticated owner of that uid. No cross-user access.
    //
    // The one exception is users/{uid}/meta/stravaConnection: see below.
    // Rules are OR'd across matching `match` blocks, so a broad wildcard
    // covering that document would re-grant what the specific rule denies —
    // hence the `collection != 'meta'` carve-out here rather than a blanket
    // `/users/{uid}/{document=**}` rule.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Server-owned document. Its `athleteId` is what the Strava webhook
      // trusts to route incoming activities to a user, so a client that could
      // write it could redirect (or deny) another athlete's data. Only the
      // Cloud Function — which uses the Admin SDK and bypasses these rules —
      // writes it. The client may read it (connection status) and delete it
      // (disconnect).
      match /meta/stravaConnection {
        allow read, delete: if isOwner(uid);
        allow write: if false;
      }

      match /meta/{metaDoc} {
        allow read, write: if isOwner(uid) && metaDoc != 'stravaConnection';
      }

      // Phase 5: habits + adherence. These are already covered by the
      // generic `/{collection}/{document=**}` rule below (owner
      // read/write on every non-meta collection), but are called out
      // explicitly per the Phase 5 plan's constraint note.
      //
      // adherenceDaily/adherenceWeekly are *derived* summaries: ideally
      // they'd be server-only writes (via a Cloud Function) so a client
      // can't fabricate its own adherence score. Standing up a Function
      // for that was judged too slow for this fast-track pass, so the
      // calculator/repository compute-and-cache summaries from the
      // client instead, and these collections remain owner-writable like
      // everything else. See docs/superpowers/ISSUES.md for this gap.
      match /habits/{habitId} {
        allow read, write: if isOwner(uid);
      }

      match /habitCompletions/{date} {
        allow read, write: if isOwner(uid);
      }

      match /adherenceDaily/{date} {
        allow read, write: if isOwner(uid);
      }

      match /adherenceWeekly/{weekId} {
        allow read, write: if isOwner(uid);
      }

      // Phase 6: readiness + recovery. Also already covered by the generic
      // rule below, but called out explicitly per the Phase 6 plan's
      // constraint note — self-reported wellness data, owner-only.
      match /readiness/{date} {
        allow read, write: if isOwner(uid);
      }

      // Phase 7: AI coach. `coachRecommendations` and `coachEvents` are
      // server-written only — the Admin SDK (via `generateRecommendation`/
      // `handleCommand`) is the only writer, so the AI's proposals and the
      // audit trail of what was actually applied can't be forged or edited
      // by a client. The client may only read them. These two collections
      // must be excluded from the broad wildcard below (not just covered
      // redundantly by it, as the Phase 5/6 explicit blocks are) — that
      // wildcard grants owner write, which would defeat this rule.
      match /coachRecommendations/{recommendationId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /coachEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Phase 8: budget-aware meal planning. Already covered by the generic
      // `/{collection}/{document=**}` rule below, but called out explicitly
      // per the Phase 5/6/7 plans' constraint note. Unlike
      // `coachRecommendations`/`coachEvents`, `mealPlans` is owner-writable,
      // not server-only: a user can create/edit a meal plan directly (same
      // as `goals`/`habits`, which are also both user-editable AND
      // coach-command-writable), and `handleCommand` writes it via the
      // Admin SDK regardless of these rules. See docs/superpowers/ISSUES.md,
      // "Phase 8" for the reasoning.
      match /budgetSettings/{settingsDoc} {
        allow read, write: if isOwner(uid);
      }

      match /priceSnapshots/{snapshotId} {
        allow read, write: if isOwner(uid);
      }

      match /mealTemplates/{templateId} {
        allow read, write: if isOwner(uid);
      }

      match /mealPlans/{planId} {
        allow read, write: if isOwner(uid);
      }

      match /{collection}/{document=**} {
        allow read, write: if isOwner(uid) && collection != 'meta' &&
            collection != 'coachRecommendations' && collection != 'coachEvents';
      }
    }
  }
}
